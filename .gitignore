# Qt Creator
.qtcreator/
*.user
*.user.*
*.autosave

# 编译输出
build/
debug/
release/
OrangeToolsApp/

# qmake 生成的文件
Makefile
Makefile.*
.qmake.stash
*.pro.user
*.pro.user.*

# 编译生成的文件
*.o
*.obj
*.exe
*.dll
*.so
*.dylib
*.a
*.lib

# qiubai 的工具二进制是编译输入，必须随源码提交；其他构建产物继续忽略
!/qiubai/*.exe
!/qiubai/*.dll

# 欧加随应用提供的工具：只放行明确的正式依赖路径
!/qiubai/bin/7zip/7z.dll
!/qiubai/bin/7zip/7z.exe
!/qiubai/bin/lpmake/lpmake.exe
!/qiubai/bin/platform-tools/AdbWinApi.dll
!/qiubai/bin/platform-tools/AdbWinUsbApi.dll
!/qiubai/bin/platform-tools/adb.exe
!/qiubai/bin/platform-tools/etc1tool.exe
!/qiubai/bin/platform-tools/fastboot.exe
!/qiubai/bin/platform-tools/hprof-conv.exe
!/qiubai/bin/platform-tools/libwinpthread-1.dll
!/qiubai/bin/platform-tools/make_f2fs.exe
!/qiubai/bin/platform-tools/make_f2fs_casefold.exe
!/qiubai/bin/platform-tools/mke2fs.exe
!/qiubai/bin/platform-tools/sqlite3.exe

# MOC 生成的文件
moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h

# 临时文件
*.tmp
*.bak
*.swp
*~

# Windows 特定
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS 特定
.DS_Store
.AppleDouble
.LSOverride

# 日志文件
*.log

# 打包输出
package_*/
*.zip

# 下载发布包及校验文件
dist/
