# Qt Creator
.qtcreator/
*.user
*.user.*
*.autosave

# 编译输出
build/
debug/
release/
OrangeToolsApp/

# qmake 生成的文件
Makefile
Makefile.*
.qmake.stash
*.pro.user
*.pro.user.*

# 编译生成的文件
*.o
*.obj
*.exe
*.dll
*.so
*.dylib
*.a
*.lib

# qiubai 的工具二进制是编译输入，必须随源码提交；其他构建产物继续忽略
!/qiubai/*.exe
!/qiubai/*.dll

# 欧加随应用提供的工具：只放行明确的正式依赖路径
!/qiubai/bin/7zip/7z.dll
!/qiubai/bin/7zip/7z.exe
!/qiubai/bin/lpmake/lpmake.exe

# MOC 生成的文件
moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h

# 临时文件
*.tmp
*.bak
*.swp
*~

# Windows 特定
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS 特定
.DS_Store
.AppleDouble
.LSOverride

# 日志文件
*.log

# 打包输出
package_*/
*.zip

# 下载发布包及校验文件
dist/

# 任务私有输入快照、调试符号与验证证据，不可随源码提交
/TEMP/
*.debug

# 云端下载文件属于用户数据，不提交
/OrangeToolsApp/download/
